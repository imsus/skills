{
  "name": "imsus-skills",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check": "bun run src/cli.ts check",
    "manifest": "bun run src/cli.ts manifest",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun test && bun run check && bun run src/cli.ts manifest --check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "effect": "4.1.0"
  }
}
